{
  "name": "sld-power-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0 <23 || >=24" },
  "scripts": {
    "predev": "node scripts/prepare-static.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-static.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/*.test.ts",
    "test": "vitest run",
    "provision:runtime": "node scripts/provision-runtime.mjs",
    "test:runtime": "node tests/runtime.proof.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.23.0"
  }
}
